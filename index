<style>
:root{--primary:#002147;--accent:#F0C869;--bg:#F5F7FA;--card:#FFFFFF;--text:#1A1A2E;--muted:#4A4A6A;--border:#E8ECF1;--green:#0F7B3A;--orange:#B45309;--red:#B91C1C;--radius:18px}
*{box-sizing:border-box}
body{margin:0;font-family:'Inter',-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--text);line-height:1.7;font-size:18px}
a{color:var(--primary)}
.container{max-width:1200px;margin:0 auto;padding:0 24px}
.topbar{background:var(--primary);color:white;padding:12px 0}
.topbar-inner{display:flex;justify-content:space-between;align-items:center}
.brand{display:flex;gap:10px;align-items:center;font-weight:700;font-size:20px}
.top-actions{display:flex;gap:10px;align-items:center}
.btn{padding:12px 18px;border-radius:12px;border:1px solid var(--border);background:white;color:var(--text);cursor:pointer;font-size:16px}
.btn-ghost{background:transparent;color:white;border-color:rgba(255,255,255,0.25)}
.btn-primary{background:var(--primary);color:white;border-color:transparent}
.btn-accent{background:var(--accent);color:var(--primary);border-color:transparent;font-weight:700}
.banner{background:#FEF3C7;border-left:4px solid var(--accent);color:#78350F;padding:10px 12px;font-size:13px}
.hero{display:grid;grid-template-columns:1.2fr 0.9fr;gap:20px;padding:28px 0 18px 0}
.hero h1{margin:0 0 10px 0;font-size:42px;color:var(--primary)}
.sub{color:var(--muted);font-size:18px}
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:22px;box-shadow:0 20px 60px rgba(0,33,71,0.08)}
.grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
label{display:block;margin-bottom:8px;color:var(--muted);font-size:14px}
input,select,textarea{width:100%;height:52px;padding:0 14px;border:1px solid #D1D5DB;border-radius:12px;background:white;color:var(--text);font-size:18px}
textarea{height:auto;min-height:120px;padding:12px 14px}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(0,33,71,0.12)}
.tabs{display:flex;gap:10px;margin-bottom:12px}
.tab{flex:1;text-align:center;padding:12px;border-radius:12px;border:1px solid var(--border);cursor:pointer;font-weight:600;background:white}
.tab.active{background:var(--primary);color:white;border-color:transparent}
.submit-btn{display:inline-flex;align-items:center;gap:10px;background:var(--primary);color:white;border:none;border-radius:40px;padding:16px 48px;font-size:20px;font-weight:700;cursor:pointer}
.submit-btn:hover{background:#00356B;transform:translateY(-2px);box-shadow:0 14px 36px rgba(0,33,71,0.14)}
.gdpr{background:#F8FAFC;border:1px solid var(--border);border-radius:12px;padding:16px;color:var(--muted);font-size:14px}
.info-bar{background:#F8FAFC;border:1px solid var(--border);border-radius:16px;padding:16px 24px;color:var(--muted);font-size:15px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px}
.badge{display:inline-block;padding:4px 10px;border-radius:999px;font-size:12px;border:1px solid var(--border);background:white;color:var(--muted)}
.counter-banner{background:linear-gradient(135deg,#002147,#1A3A6B);color:white;border-radius:16px;padding:24px 32px;display:grid;grid-template-columns:1.1fr 0.8fr 1.2fr;gap:16px;align-items:center}
.counter-banner .big{color:var(--accent);font-size:36px;font-weight:800;line-height:1.1}
.uni-card{background:white;border:1px solid var(--border);border-radius:16px;box-shadow:0 12px 34px rgba(0,33,71,0.06);display:flex;flex-direction:column;justify-content:space-between}
.uni-card .top-bar{height:4px;border-radius:16px 16px 0 0}
.uni-card .body{padding:18px}
.uni-card .name{font-size:22px;font-weight:700;color:var(--text)}
.uni-card .meta{font-size:14px;color:var(--muted);margin-top:8px}
.uni-card .actions{padding:0 18px 18px 18px}
.tag{display:inline-flex;align-items:center;gap:8px;padding:4px 10px;border-radius:999px;font-size:13px;border:1px solid var(--border)}
.tag.rush{color:var(--red);border-color:#fecaca;background:#fef2f2}.tag.match{color:var(--orange);border-color:#fde68a;background:#fffbeb}.tag.safe{color:var(--green);border-color:#bbf7d0;background:#f0fdf4}
.progress{height:10px;background:#EEF2F7;border-radius:999px;overflow:hidden}
.progress .fill{height:100%;border-radius:999px;width:0%;transition:width .9s ease}
.btn-outline{border:1px solid var(--border);background:white;color:var(--text);border-radius:40px;padding:10px 18px;cursor:pointer}
.table-wrap{overflow:auto;background:white;border:1px solid var(--border);border-radius:16px}
table{width:100%;border-collapse:collapse}
th,td{border-bottom:1px solid var(--border);padding:12px;text-align:left;font-size:15px}
th{background:#F8FAFC;color:var(--muted);font-weight:600}
tr:nth-child(even){background:#FCFCFD}
.footer{padding:22px 0;border-top:1px solid var(--border);color:#6B6B8A;text-align:center;margin-top:28px;font-size:14px}
.small{color:#6B6B8A;font-size:14px}
.locked{position:relative}
.lock-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(245,247,250,0.2),rgba(245,247,250,0.9));backdrop-filter:blur(2px);border-radius:16px;display:flex;align-items:center;justify-content:center}
.lock-box{background:white;border:1px solid var(--border);border-radius:16px;padding:16px 20px;box-shadow:0 12px 28px rgba(0,33,71,0.08);text-align:center;max-width:340px}
.resource-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.resource{background:white;border:1px solid var(--border);border-radius:14px;padding:14px}
.pricing{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.price-card{background:white;border:1px solid var(--border);border-radius:18px;padding:22px}
.price-card.featured{border:2px solid var(--accent);box-shadow:0 16px 44px rgba(0,33,71,0.08)}
.price-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.price-name{font-weight:700;color:var(--primary)}
.price{font-size:28px;font-weight:800;color:var(--primary)}
.report-section{background:white;border:1px solid var(--border);border-radius:18px;padding:22px}
@media print{.topbar,.banner,.footer,.hide-print{display:none!important}body{background:white}}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.fade-up{animation:fadeUp .6s ease both}
@media(max-width:1024px){.hero{grid-template-columns:1fr}.counter-banner{grid-template-columns:1fr}.grid3,.pricing,.grid4{grid-template-columns:1fr}}
@media(max-width:768px){.grid2,.resource-grid{grid-template-columns:1fr}h1{font-size:28px}.submit-btn{width:100%;justify-content:center}}
</style>
</head>
