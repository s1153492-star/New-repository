function t(k){return T[lang][k]||''}
function esc(s){return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function uname(u){return lang==='en'?u.name_en:u.name_zh}
function unote(u){return lang==='en'?u.note_en:u.note_zh}
function classifyDomesticDelta(delta){return delta<-20?0:delta<=15?1:2}
function recommendDomestic(score,providedRank,level){const estRank=estimateRankFromScore(score);const rank=(typeof providedRank==='number'&&!Number.isNaN(providedRank)&&providedRank>0)?providedRank:estRank;let list=DB.domestic.slice();if(level==='985')list=list.filter(u=>u.level==='985');if(level==='211')list=list.filter(u=>u.level==='211'||u.level==='985');if(level==='双一流')list=list.filter(u=>['985','211','双一流'].includes(u.level));const scored=list.map(u=>{const scoreDelta=score-u.score_line;const rankDelta=rank!=null?(rank-u.rank_hint):null;const scoreFit=Math.min(100,Math.max(10,60+scoreDelta*0.8));const rankFit=rank!=null?Math.min(100,Math.max(10,60-rankDelta*0.003)):scoreFit;const ms=Math.round((scoreFit*0.6)+(rankFit*0.4));const cat=ms<60?0:ms<=80?1:2;return {...u,matchScore:ms,scoreDelta,rankDelta,rankUsed:rank,cat}}).sort((a,b)=>b.matchScore-a.matchScore);const g=[[],[],[]];scored.forEach(x=>g[x.cat].push(x));return {g:g.map(arr=>arr.slice(0,10)),scored,rank,estRank}}
function recommendOverseas(gpa,ielts,country){
  let list=DB.overseas.filter(u=>country?u.country===country:true);
  const scored=list.map(u=>{const raw=(gpa/u.gpa)*60+(ielts/u.ielts)*40;const ms=Math.min(100,Math.round(raw*100)/100);return {...u,matchScore:ms,cat:ms<60?0:ms<=80?1:2}}).sort((a,b)=>b.matchScore-a.matchScore);
  const g=[[],[],[]];scored.forEach(x=>g[x.cat].push(x));return {g,scored};
}
function balance(g){const out=g.map(a=>a.slice());const empty=out.map((a,i)=>a.length===0?i:-1).filter(i=>i>=0);if(empty.length===0)return out;const all=out.flat().sort((a,b)=>Math.abs(a.matchScore-65)-Math.abs(b.matchScore-65));for(const c of empty){const x=all.find(y=>y.cat!==c&&out[y.cat].length>1);if(!x)continue;out[x.cat]=out[x.cat].filter(y=>y.id!==x.id);x.cat=c;out[c].push(x)}return out}
function regionLabel(r){return {mainland:t('region_mainland'),HK:t('region_hk'),SG:t('region_sg'),US:t('region_us'),UK:t('region_uk'),AU:t('region_au'),Global:t('region_global')}[r]||r}
function tierAccess(tier, required){const o=['free','basic','pro'];return o.indexOf(tier)>=o.indexOf(required)}

function filterResources(list, tier){
  const q=resFilter.q.toLowerCase();
  return list.filter(r=>{
    if(resFilter.cat!=='all' && r.cat!==resFilter.cat) return false;
    if(resFilter.region!=='all' && !r.regions.includes(resFilter.region) && !r.regions.includes('Global')) return false;
    if(q && !(r.name_zh.toLowerCase().includes(q) || r.name_en.toLowerCase().includes(q) || r.cat.toLowerCase().includes(q))) return false;
    return true;
  });
}

