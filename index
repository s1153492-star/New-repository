function policyFit(score,p){return Math.round(Math.min(100,Math.max(10,60+(score-p.score_hint)*0.8)))}
function policySection(province,score){const items=(POLICY_DB[province]||[]).map(p=>({...p,fit:policyFit(score,p)})).sort((a,b)=>b.fit-a.fit);if(items.length===0)return '<div class="card"><div style="font-weight:700">省份升学政策（生成后展示） · '+(province||'-')+'</div><div class="small" style="margin-top:8px">当前省份暂无示例政策。</div></div>';return '<div class="card"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px"><div style="font-weight:700">省份升学政策（生成后展示） · '+province+'</div><div class="small">基于你输入的分数实时计算</div></div><div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:12px">'+items.map(p=>'<div class="policy-chip">'+(lang==='en'?p.name_en:p.name_zh)+' <span class="badge">匹配度 '+p.fit+'%</span></div>').join('')+'</div><div class="grid2">'+items.map(p=>'<div style="background:#F8FAFC;border:1px solid var(--border);border-radius:14px;padding:14px"><div style="font-weight:700">'+(lang==='en'?p.name_en:p.name_zh)+'</div><div class="small" style="margin-top:4px">窗口：'+p.window+'</div><div style="margin-top:8px;font-weight:600">建议动作</div><ul style="margin:6px 0 0 18px">'+(lang==='en'?p.actions_en:p.actions_zh).map(a=>'<li>'+a+'</li>').join('')+'</ul></div>').join('')+'</div></div>'}
function scoreSegment(score){if(score>=680)return 'top';if(score>=660)return 'high';if(score>=640)return 'midhigh';if(score>=620)return 'mid';if(score>=600)return 'midlow';return 'low'}
function scoreRecommendedResourceIds(score){const seg=scoreSegment(score);const map={top:['r08','r13','r17','r24','r34'],high:['r07','r15','r16','r25','r35'],midhigh:['r06','r10','r11','r33','r39'],mid:['r04','r05','r22','r23','r37'],midlow:['r03','r32','r36','r47','r48'],low:['r01','r02','r32','r36','r47']};return map[seg]||map.mid}
function scoreResourceCards(score){const ids=new Set(scoreRecommendedResourceIds(score));const tier=getTier();const limit=TIERS[tier].courses;const list=RESOURCES.filter(r=>ids.has(r.id));return '<div class="card" style="margin-top:14px"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px"><div style="font-weight:700">'+(lang==='zh'?'分数段资源推荐':'Score-segment resource recommendations')+'</div><div class="small">'+(lang==='zh'?'当前分数：':'Score: ')+score+'</div></div><div class="grid3">'+list.map((r,idx)=>{const unlocked=idx<limit;return '<div style="background:#F8FAFC;border:1px solid var(--border);border-radius:14px;padding:14px"><div style="font-weight:700">'+(lang==='en'?r.name_en:r.name_zh)+'</div><div class="small" style="margin-top:6px">'+r.cat+' · '+r.tag+'</div><div style="margin-top:8px">'+(unlocked?'<span class="badge">'+(lang==='zh'?'可查看':'Available')+'</span>':'<a class="btn btn-accent" href="#/pricing">'+(lang==='zh'?'升级查看':'Upgrade')+'</a>')+'</div></div>'}).join('')+'</div></div>'}
