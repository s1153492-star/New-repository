}

window.deleteItem=function(type,id){if(type==='domestic'){DB.domestic=DB.domestic.filter(u=>u.id!==id)}else{DB.overseas=DB.overseas.filter(u=>u.id!==id)}saveAll(DB);render()};

function render(){
  document.getElementById('langZh').onclick=()=>{lang='zh';localStorage.setItem('edupath_lang','zh');render()};
  document.getElementById('langEn').onclick=()=>{lang='en';localStorage.setItem('edupath_lang','en');render()};
  document.getElementById('footText').textContent=t('foot');
  document.getElementById('pricingLink').textContent=lang==='zh'?'⭐ 套餐':'⭐ Packages';
  document.getElementById('resLink').textContent=lang==='zh'?'📚 课程资源库':'📚 Resources';
  document.getElementById('adminLink').textContent='⚙️ '+(lang==='zh'?'后台':'Admin');
  const h=(location.hash||'#/').split('?')[0];
  if(h==='#/result')renderResult();
  else if(h==='#/pricing')renderPricing();
  else if(h==='#/resources')renderResources();
  else if(h==='#/admin-login')renderAdminLogin();
  else if(h==='#/admin')renderAdmin();
  else if(h==='#/add')openEditor(null,'domestic');
  else if(h.startsWith('#/edit/')){const[,,type,id]=h.split('/');const u=(type==='domestic'?DB.domestic:DB.overseas).find(x=>x.id===id)||null;openEditor(u,type)}
  else renderIndex();
}
window.addEventListener('hashchange',render);render();
</script>
</body>
</html>
